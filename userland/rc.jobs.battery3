# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
# An hour of use before Settings > Battery is opened (with adsp=1): applications opened in turn -- Settings, Notes,
# Calendar -- so that the power log has an hour of their use to show; then the battery page, scrolled, and Battery
# Health & Charging, for screenshots; at the end what the power log has collected (battery_test powerlog).
/polaris/bin/sound_test springboard
/polaris/bin/rwtouch wait 20
/polaris/bin/battery_test open prefs:root=General
/polaris/bin/rwtouch wait 600
/polaris/bin/battery_test open mobilenotes://
/polaris/bin/rwtouch wait 600
/polaris/bin/battery_test open calshow://
/polaris/bin/rwtouch wait 600
/polaris/bin/battery_test open prefs:root=DISPLAY
/polaris/bin/rwtouch wait 600
/polaris/bin/battery_test open mobilenotes://
/polaris/bin/rwtouch wait 600
/polaris/bin/battery_test open calshow://
/polaris/bin/rwtouch wait 600
/polaris/bin/battery_test open prefs:root=BATTERY_USAGE
/polaris/bin/rwtouch wait 15 drag 0.5 0.85 0.5 0.35 1500 400 wait 4 drag 0.5 0.85 0.5 0.35 1500 400 wait 6
/polaris/bin/battery_test open prefs:root=BATTERY_USAGE&path=BATTERY_HEALTH
/polaris/bin/rwtouch wait 10
/polaris/bin/battery_test powerlog
