# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
# The Darwin root volume on the phone's flash as the root (flashboot.apfs resident,
# root_apfs=ufs_darwin ufs=2 bootcpu=7; src/init.c, flash_root), seen from user space: what
# is mounted where, the root's own files read through read(2) and through a mapping.
# The host's hashes: SystemVersion.plist 47687daabd864929, usr/lib/dyld 602fba9751ad6aa7,
# usr/sbin/mediaserverd 895037cd97f96801.
/sbin/mount
/bin/df
/polaris/bin/vol_ls fs /
/polaris/bin/vol_ls fs /private/preboot
/polaris/bin/vol_ls ls /
/polaris/bin/vol_ls ls /Applications
/polaris/bin/vol_ls ls /System/Cryptexes/OS/System/Library/Caches/com.apple.dyld /polaris
/polaris/bin/vol_ls cat /System/Library/CoreServices/SystemVersion.plist
/polaris/bin/vol_ls hash /System/Library/CoreServices/SystemVersion.plist /usr/lib/dyld /usr/sbin/mediaserverd
/polaris/bin/apfs_mmap_test mmap /usr/sbin
/polaris/bin/apfs_mmap_test read /usr/sbin 65536
/bin/ps -A
